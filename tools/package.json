{
  "name": "directorio-tools",
  "private": true,
  "description": "Tailwind y validación del directorio",
  "scripts": {
    "build:css": "tailwindcss -i ./source.css -o ../assets/css/tailwind.css --minify",
    "check": "node release.mjs --check && node check.mjs",
    "test": "node --test",
    "release": "node release.mjs",
    "build:js": "node build.mjs",
    "test:browser": "node browser-check.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.65.1",
    "tailwindcss": "^3.4.17"
  }
}
